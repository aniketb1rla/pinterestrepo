# Copy to .env and edit.

# --- Dataset repo ---
DATASET_REPO_URL=https://github.com/aniketb1rla/pinterestrepo.git
# Local clone location (default: ./pinterestrepo inside this project)
# DATASET_REPO_DIR=./pinterestrepo
GIT_BRANCH=main
AUTO_PUSH=true
# Optional. Leave blank to use your normal git/GitHub login.
# Otherwise: GitHub → Settings → Developer settings → Fine-grained token,
# repo = pinterestrepo, permission Contents: Read and write.
GITHUB_TOKEN=
# Turn on if the repo grows past ~1 GB (needs `git lfs` installed)
USE_GIT_LFS=false

# --- Browser ---
# chrome = your installed Google Chrome (best for Google sign-in). msedge or chromium also work.
BROWSER_CHANNEL=chrome
HEADLESS=false

# --- Industry sorting ---
# keywords = free/offline.  gemini = looks at the image, writes rich captions (recommended).
CLASSIFIER=keywords
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# gemini only: skip plain photos that aren't designed graphics
DROP_NON_DESIGN=false

# --- Images ---
MAX_IMAGE_SIDE=1440
JPEG_QUALITY=90
DUPLICATE_HAMMING=4
MAX_SCROLLS=40
